@1 = ~Fichiers de script de shader pour le controle de l'eclairage~
@2 = ~Modifier la temperature des couleurs~
@3 = ~Parametres avances : modifier la teinte, la saturation et la luminosite~
@10 = ~Parametres avances~

@100 = ~Parametres neutres pour le contraste, la luminosite et le gamma~

@101 = ~Contraste, luminosite et gamma legerement augmentes~
@102 = ~Contraste, luminosite et gamma moderement augmentes (recommande)~
@103 = ~Contraste, luminosite et gamma fortement augmentes~
@104 = ~Contraste, luminosite et gamma legerement reduits~
@105 = ~Contraste, luminosite et gamma moderement reduits~

