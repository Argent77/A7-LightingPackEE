@115 = ~适度降低亮度~

@116 = ~略微提高伽马值~
@117 = ~适度提高伽马值~
@118 = ~大幅提高伽马值~
@119 = ~略微降低伽马值~
@120 = ~适度降低伽马值~

@121 = ~手动输入光照数值~

@200 = ~输入对比度数值（数字 >= 0.0，中间值=1.0）：~
@201 = ~输入亮度数值（数字在区间 [-1.0, 1.0] 内，中间值=0.0）：~
@202 = ~输入伽马数值（数字>0.0，中间值=1.0）：~
@203 = ~已输入以下数值：~
@204 = ~对比度=%contrast%~
@205 = ~亮度=%brightness%~
@206 = ~伽马值=%gamma%~

@207 = ~这些数值正确吗[y/n/c]？~
@208 = ~这些数值正确吗？（输入y表示是，n表示否，c表示取消）：~
@209 = ~该数值正确吗 [y/n/c]？~
@210 = ~该数值正确吗？（输入y表示是，n表示否，c表示取消）：~
@211 = ~已输入以下数值：~
@212 = ~使用“中间值”数值。~

@300 = ~应用预设“冰蓝”（15,000K）~
@301 = ~应用预设“阴天”（7,500K）~
@302 = ~应用预设“日光（中间值）”（6,500K）~
@303 = ~应用预设“阳光”（5,500K）~
@304 = ~应用预设“月光”（4,200K）~
@305 = ~应用预设“日落”（3,500K）~
@306 = ~应用预设“灯泡”（2,800K）~
@307 = ~应用预设“烛光”（1,900K）~
@308 = ~手动输入色温数值~
@350 = ~输入色温数值（区间[1000,40000]，中间值=6500，禁用=0）：~
@351 = ~色温=%kelvin%K~
@352 = ~示例：
冰蓝：15000
阴天：7500
日光：6500（中间值）
阳光：5500
月光：4200
日落：3500
灯泡：2800
蜡烛：1900~

@400 = ~手动输入色相数值~
@401 = ~手动输入饱和度数值~
@402 = ~手动输入亮度数值~
@403 = ~输入色相、饱和度、亮度数值~

@410 = ~输入色相数值（区间 [-1.0, 1.0]，中间值=0.0）：~
@411 = ~输入饱和度数值（数字 >= 0.0，中间值=1.0）：~
@412 = ~输入亮度数值（数字 >= 0.0，中间值=1.0）：~
@413 = ~色相=%hue%~
@414 = ~饱和度=%saturation%~
@415 = ~亮度=%lightness%~

